<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImagepixelBackup.App.ViewModels"
             xmlns:local="using:ImagepixelBackup.App"
             x:Class="ImagepixelBackup.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Margin="32,28" Spacing="16">

            <Button Content="←  Zurück" Command="{Binding BackCommand}" />

            <StackPanel Orientation="Horizontal" Spacing="14">
                <Image Source="/Assets/app-icon.png" Width="56" Height="56" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="Imagepixel Backup" />
                    <TextBlock Classes="subtle" Text="{Binding Version}" />
                </StackPanel>
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Anleitung" />
                    <TextBlock Classes="subtle" Text="{x:Static local:Texts.GuideHint}" />
                    <Button Classes="accent" Content="Anleitung öffnen" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static vm:AboutViewModel.GuideUrl}" />
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding ShowStartAtLogin}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Im Hintergrund sichern" />
                    <TextBlock Classes="subtle" Text="{x:Static local:Texts.StartAtLoginHint}" />
                    <CheckBox Content="Bei der Anmeldung automatisch starten" IsChecked="{Binding StartAtLogin}" />
                    <Border Classes="warning" IsVisible="{Binding HasStartAtLoginProblem}">
                        <TextBlock Text="{Binding StartAtLoginProblem}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Freie Software" />
                    <TextBlock Classes="subtle"
                               Text="Imagepixel Backup ist quelloffen und steht unter der BSD-2-Clause-Lizenz. Deine Daten werden auf deinem Rechner verschlüsselt, bevor sie ihn verlassen." />
                    <Button Content="Quelltext auf GitHub" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static vm:AboutViewModel.SourceUrl}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="Nutzungshinweise" />
                    <TextBlock Classes="subtle" Text="{x:Static local:Texts.TermsReminder}" />
                    <Button Content="Nutzungshinweise öffnen" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static vm:AboutViewModel.TermsUrl}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="heading" Text="Enthaltene Komponenten" />

                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="Medium" Text="restic" />
                        <TextBlock Classes="subtle"
                                   Text="Das Backup-Programm, das sichert, verschlüsselt und wiederherstellt. Copyright (c) 2014, Alexander Neumann. BSD-2-Clause-Lizenz." />
                        <Button Content="restic.net" Margin="0,4,0,0" Command="{Binding OpenLinkCommand}"
                                CommandParameter="{x:Static vm:AboutViewModel.ResticUrl}" />
                    </StackPanel>

                    <StackPanel Spacing="2" IsVisible="{Binding ShowWinFsp}">
                        <TextBlock FontWeight="Medium" Text="WinFsp" />
                        <TextBlock Classes="subtle"
                                   Text="Zeigt das Backup als Laufwerk an. WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos." />
                        <Button Content="github.com/winfsp/winfsp" Margin="0,4,0,0" Command="{Binding OpenLinkCommand}"
                                CommandParameter="{x:Static vm:AboutViewModel.WinFspUrl}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="Medium" Text="Weitere" />
                        <TextBlock Classes="subtle"
                                   Text="Avalonia, .NET, CommunityToolkit.Mvvm und cgofuse (MIT-Lizenz), Schrift Inter (SIL Open Font License). Die vollständigen Lizenztexte liegen im Programmordner in der Datei THIRD-PARTY-NOTICES.txt." />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
