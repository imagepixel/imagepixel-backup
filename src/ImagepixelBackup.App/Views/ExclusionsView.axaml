<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImagepixelBackup.App.ViewModels"
             xmlns:local="using:ImagepixelBackup.App"
             x:Class="ImagepixelBackup.App.Views.ExclusionsView"
             x:DataType="vm:ExclusionsViewModel"
             x:Name="Root">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Margin="32,28" Spacing="16">

            <StackPanel>
                <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Classes="subtle" Text="{Binding Path}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Classes="note">
                <TextBlock TextWrapping="Wrap" Text="{x:Static local:Texts.ExclusionsNote}" />
            </Border>

            <!-- suggestions in plain words; none of them is ticked unless the customer does it -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="heading" Text="Vorschläge" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetOption">
                                <CheckBox IsChecked="{Binding IsOn}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                        <TextBlock Classes="subtle" Text="{Binding Detail}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Große Dateien" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox Content="Keine Dateien, die größer sind als" IsChecked="{Binding LimitSize}" />
                        <ComboBox ItemsSource="{Binding SizeOptions}" SelectedIndex="{Binding SizeIndex}" MinWidth="110"
                                  IsEnabled="{Binding LimitSize}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- rules of the customer's own, put together from a choice and a word -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Eigene Regeln" />
                    <TextBlock Classes="subtle" Text="{x:Static local:Texts.ExclusionsRulesHint}" />

                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuleItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3">
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="Entfernen"
                                            Command="{Binding #Root.((vm:ExclusionsViewModel)DataContext).RemoveRuleCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="warning" IsVisible="{Binding LeavesOutGit}">
                        <TextBlock TextWrapping="Wrap" Text="{x:Static local:Texts.ExclusionsGitWarning}" />
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ComboBox ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding NewKindIndex}" MinWidth="250" />
                        <TextBox Grid.Column="1" Text="{Binding NewValue}" PlaceholderText="z. B. log oder node_modules" />
                        <Button Grid.Column="2" Content="Hinzufügen" Command="{Binding AddRuleCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding RuleMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource ProblemTextBrush}" IsVisible="{Binding HasRuleMessage}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Speichern" Padding="28,9" Command="{Binding SaveCommand}" />
                <Button Content="Abbrechen" Padding="20,9" Command="{Binding CancelCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
