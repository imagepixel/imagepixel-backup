<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImagepixelBackup.App.ViewModels"
             xmlns:local="using:ImagepixelBackup.App"
             x:Class="ImagepixelBackup.App.Views.ExclusionSuggestionView"
             x:DataType="vm:ExclusionSuggestionViewModel">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Margin="32,28" Spacing="16">

            <StackPanel>
                <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Classes="subtle" Text="{Binding Path}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Classes="note">
                <TextBlock TextWrapping="Wrap" Text="{x:Static local:Texts.SuggestionIntro}" />
            </Border>

            <!-- what the look through the folder found, with the space each group takes -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SuggestionOption">
                                <CheckBox IsChecked="{Binding IsOn}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Size}" />
                                        <TextBlock Classes="subtle" Text="{Binding Detail}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Classes="subtle" Text="{x:Static local:Texts.SuggestionLater}" />

            <WrapPanel>
                <Button Classes="accent" Margin="0,0,8,8" Padding="20,9" Content="Vorschlag übernehmen und sichern"
                        Command="{Binding AcceptCommand}" />
                <Button Margin="0,0,8,8" Padding="20,9" Content="Ohne Ausnahmen sichern" Command="{Binding DeclineCommand}" />
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
