<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImagepixelBackup.App.ViewModels"
             xmlns:core="using:ImagepixelBackup.Core"
             xmlns:local="using:ImagepixelBackup.App"
             x:Class="ImagepixelBackup.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- header -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Image Source="/Assets/app-icon.png" Width="44" Height="44" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="Imagepixel Backup" />
                    <TextBlock Classes="subtle" Text="{Binding StorageName}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Info" Command="{Binding ShowAboutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="28,22" Spacing="14">

                <!-- how much of the booked storage is used -->
                <Border Classes="card" Padding="20,14" IsVisible="{Binding HasStorageStatus}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Dein Speicher bei Imagepixel" />
                            <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding StorageDetail}" TextWrapping="NoWrap" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding StoragePercent}"
                                     Classes.warning="{Binding HasStorageWarning}" />
                        <TextBlock Text="{Binding StorageText}" />
                        <Border Classes="warning" IsVisible="{Binding HasStorageWarning}">
                            <TextBlock Text="{Binding StorageWarning}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- the storage turns down the access data: a new setup code is the way out -->
                <Border Classes="warning" IsVisible="{Binding HasAccessProblem}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Static local:Texts.AccessProblem}" />
                        <Button Grid.Column="1" Content="{x:Static local:Texts.ChangeStorage}" VerticalAlignment="Center"
                                Command="{Binding ChangeStorageCommand}" />
                    </Grid>
                </Border>

                <!-- macOS and Linux: nothing starts the application at login until the user agrees -->
                <Border Classes="warning" IsVisible="{Binding ShowStartAtLoginNote}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Imagepixel Backup startet noch nicht von selbst. Nach einem Neustart laufen die geplanten Sicherungen erst wieder, wenn du das Programm öffnest." />
                        <Button Grid.Column="1" Content="Automatisch starten" VerticalAlignment="Center"
                                Command="{Binding StartAtLoginCommand}" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="heading" Text="Gesicherte Ordner" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="accent" Content="+  Ordner hinzufügen"
                            Command="{Binding AddFolderCommand}" />
                </Grid>

                <!-- cloud storage that is set up on this computer and not backed up yet -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAvailableCloudFolders}">
                    <TextBlock Classes="subtle" Text="Cloud-Speicher sichern:" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding AvailableCloudFolders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:CloudFolder">
                                <Button Content="{Binding Name, StringFormat='+  {0}'}"
                                        Command="{Binding #Root.((vm:DashboardViewModel)DataContext).AddCloudFolderCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Classes="card" IsVisible="{Binding HasNoFolders}">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="Medium" Text="Noch wird nichts gesichert." />
                        <TextBlock Classes="subtle"
                                   Text="Wähle einen Ordner aus, zum Beispiel deine Dokumente, und sein Ziel im Speicher. Danach wird er gesichert und von da an automatisch jede Stunde im Hintergrund." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderItemViewModel">
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Classes="subtle" Text="{Binding Path}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- pausing keeps the folder waiting until the customer goes on, cancelling only ends this run -->
                                        <Button Grid.Column="1" Content="Pausieren" VerticalAlignment="Center"
                                                Command="{Binding PauseCommand}" IsVisible="{Binding IsRunning}" />
                                        <Button Grid.Column="2" Content="Jetzt sichern" VerticalAlignment="Center"
                                                Command="{Binding BackupNowCommand}" IsVisible="{Binding CanStart}" />
                                        <Button Grid.Column="2" Classes="accent" Content="Fortsetzen" VerticalAlignment="Center"
                                                Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
                                        <Button Grid.Column="2" Content="Abbrechen" VerticalAlignment="Center"
                                                Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                                        <Button Grid.Column="3" Content="Entfernen" VerticalAlignment="Center"
                                                Command="{Binding RemoveCommand}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ComboBox ItemsSource="{Binding ScheduleOptions}"
                                                  SelectedIndex="{Binding ScheduleIndex}" MinWidth="230" />
                                        <TimePicker SelectedTime="{Binding DailyTime}" ClockIdentifier="24HourClock"
                                                    MinuteIncrement="5" IsVisible="{Binding IsDaily}" />

                                        <!-- what the backup of this folder leaves out, if the customer asked for it -->
                                        <Button Content="Ausnahmen …" Command="{Binding EditExclusionsCommand}" />
                                        <TextBlock Classes="subtle" Text="{Binding ExclusionsText}" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasExclusions}" />
                                    </StackPanel>

                                    <!-- where in the storage the backups of this folder go; changed on a page of its own -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Ziel …" Command="{Binding ChangeDestinationCommand}"
                                                IsEnabled="{Binding IsIdle}" />
                                        <TextBlock Classes="subtle" Text="{Binding DestinationText}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- old backups at a destination the folder left, waiting to be deleted -->
                                    <Border Classes="note" IsVisible="{Binding HasCleanup}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding CleanupText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Doch behalten" VerticalAlignment="Center"
                                                    Command="{Binding KeepOldBackupsCommand}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Classes="subtle" Text="{Binding CloudHint}"
                                               IsVisible="{Binding IsCloudFolder}" />

                                    <!-- the first backup waits until the customer has answered what to leave out -->
                                    <Border Classes="warning" IsVisible="{Binding HasSuggestion}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding SuggestionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="accent" Content="Vorschlag ansehen"
                                                    VerticalAlignment="Center" Command="{Binding ShowSuggestionCommand}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel IsVisible="{Binding IsRunning}" Spacing="4">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                        <TextBlock Classes="subtle" Text="{Binding ProgressText}" />
                                    </StackPanel>

                                    <!-- what the backup is working on right now, the newest line at the bottom -->
                                    <StackPanel IsVisible="{Binding CanShowDetails}" Spacing="8">
                                        <Button Content="{Binding DetailsButtonText}" Command="{Binding ToggleDetailsCommand}" />
                                        <Border Classes="terminal" IsVisible="{Binding ShowDetails}">
                                            <StackPanel VerticalAlignment="Bottom">
                                                <ItemsControl ItemsSource="{Binding DetailLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="cursor" Text="▌" IsVisible="{Binding IsRunning}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Panel IsVisible="{Binding IsIdle}">
                                        <TextBlock Classes="subtle" Text="{Binding StatusText}"
                                                   IsVisible="{Binding !HasProblem}" />
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ProblemTextBrush}"
                                                   IsVisible="{Binding HasProblem}" />
                                    </Panel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="heading" Text="Auf meine Sicherungen zugreifen" Margin="0,12,0,0" />

                <!-- the drive is left out where the computer cannot show one -->
                <UniformGrid Rows="1">
                    <Border Classes="card" Margin="0,0,12,0" IsVisible="{Binding IsMountSupported}">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Als Laufwerk öffnen" />
                            <TextBlock Classes="subtle" Text="{x:Static local:Texts.DriveHint}" />
                            <StackPanel Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsNotMounted}">
                                <!-- with backups in more than one place, the customer picks which one the drive shows -->
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMountDestinations}">
                                    <TextBlock Text="Ziel" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding MountDestinations}" SelectedItem="{Binding SelectedMountDestination}"
                                              MinWidth="160" IsEnabled="{Binding CanMount}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FoundBackup">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <!-- Windows: the letter the drive will get; the customer may pick another free one -->
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding OffersDriveLetter}">
                                    <TextBlock Text="{x:Static local:Texts.DriveLetterLabel}" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding DriveLetters}" SelectedItem="{Binding SelectedDriveLetter}"
                                              MinWidth="76" IsEnabled="{Binding CanMount}" />
                                </StackPanel>
                                <TextBlock Classes="subtle" Text="{x:Static local:Texts.NoDriveLetter}"
                                           IsVisible="{Binding HasNoDriveLetter}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="accent" Content="Laufwerk öffnen"
                                            Command="{Binding MountCommand}" IsEnabled="{Binding CanMount}" />
                                    <!-- the same backups the way they lie in the storage, encrypted -->
                                    <Button Content="Verschlüsselt öffnen" Command="{Binding OpenEncryptedCommand}"
                                            IsEnabled="{Binding CanMount}" IsVisible="{Binding CanOpenEncrypted}" />
                                    <ProgressBar IsIndeterminate="True" Width="90" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsMounting}" />
                                </StackPanel>
                                <TextBlock Classes="subtle" Text="{x:Static local:Texts.EncryptedHint}"
                                           IsVisible="{Binding CanOpenEncrypted}" />
                            </StackPanel>
                            <StackPanel Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsMounted}">
                                <TextBlock Text="{Binding MountText}" FontWeight="Medium"
                                           Foreground="{DynamicResource SuccessTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Static local:Texts.ShowDrive}" Command="{Binding ShowDriveCommand}" />
                                    <Button Content="Trennen" Command="{Binding UnmountCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Ordner wiederherstellen" />
                            <TextBlock Classes="subtle"
                                       Text="Holt einen ganzen Ordner aus einem früheren Stand zurück, zum Beispiel nach einem Festplattenschaden oder auf einen neuen Rechner." />
                            <Button Content="Wiederherstellen …" Margin="0,4,0,0" Command="{Binding RestoreCommand}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>

        <!-- status line -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,9">
            <TextBlock Classes="subtle" Text="{Binding StatusLine}" MaxLines="3" />
        </Border>
    </Grid>
</UserControl>
