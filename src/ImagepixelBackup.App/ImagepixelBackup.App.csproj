<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ImagepixelBackup</AssemblyName>
    <RootNamespace>ImagepixelBackup.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.8</Version>
    <Product>Imagepixel Backup</Product>
    <Company>Imagepixel</Company>
    <Copyright>Copyright (c) 2026, Imagepixel</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- restic is placed next to the application: built by build-restic.ps1 for Windows
       and by build-restic.sh for macOS and Linux -->
  <PropertyGroup>
    <ResticForUnix Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">..\..\bin\restic-darwin-arm64</ResticForUnix>
    <ResticForUnix Condition="'$(RuntimeIdentifier)' == 'osx-x64'">..\..\bin\restic-darwin-amd64</ResticForUnix>
    <ResticForUnix Condition="'$(RuntimeIdentifier)' == 'linux-x64'">..\..\bin\restic-linux-amd64</ResticForUnix>
  </PropertyGroup>
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('osx')) And !$(RuntimeIdentifier.StartsWith('linux')) And Exists('..\..\bin\restic.exe')">
    <None Include="..\..\bin\restic.exe" Link="restic.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(ResticForUnix)' != '' And Exists('$(ResticForUnix)')">
    <None Include="$(ResticForUnix)" Link="restic" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- rclone shows the storage as it is, encrypted: fetched by get-rclone.ps1 for Windows
       and by get-rclone.sh for Linux. macOS has no drive and needs none. -->
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('osx')) And !$(RuntimeIdentifier.StartsWith('linux')) And Exists('..\..\bin\rclone.exe')">
    <None Include="..\..\bin\rclone.exe" Link="rclone.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('..\..\bin\rclone-linux-amd64')">
    <None Include="..\..\bin\rclone-linux-amd64" Link="rclone" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImagepixelBackup.Core\ImagepixelBackup.Core.csproj" />
  </ItemGroup>
</Project>
